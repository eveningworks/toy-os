# Build outputs (make all / make iso) -- all regenerable from source
/build/
/iso/
/toy-os.iso
/userland/*.elf

# Persistent disk image (see Makefile's DISK_IMG comment) -- deliberately
# left alone by `make clean`, it's local dev state, not a repo asset.
/disk.img

# QEMU/QMP test scratch, if run from the repo root (see tools/qmp_test.py)
*.ppm
qemu.log
serial.log

# Python bytecode from tools/*.py
__pycache__/
*.pyc

# Scratch holding area for files being removed from the device-bridge
# workflow (see CLAUDE.md's "device bridge can't delete files" note) --
# never a real repo asset, just a staging spot the user empties by hand.
/_to_delete/

# Delivery workaround for Makefile being a protected file the device
# bridge won't write to directly (see CLAUDE.md's "Makefile is a
# protected file" note) -- a transient hand-off artifact the user
# copies over the real Makefile and discards, not a repo asset either.
/Makefile.new
