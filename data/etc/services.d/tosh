# The console shell. Started by init when the boot target is `text`.
#
# This is what makes a `text` boot reach a RING-3 prompt: /bin/tosh
# reads the physical console through fd 0 and spawns everything else,
# with no more privilege than the programs it starts. The kernel's own
# shell (apps/shell.c) stands down on this target and stays reachable
# over the serial debug console -- see apps/apps.c.
#
# Restart=always is what getty gets on Linux, and for the same reason:
# Ctrl-D is how you leave a shell, and a console with nobody on it is
# not a state a machine should be able to reach by pressing a key. The
# crash-loop give-up still applies, so a tosh that cannot start is
# abandoned rather than spun forever.
#
# See data/etc/services.d/README.md for the format.
# NO Target=, so it runs on a graphical boot too -- and that is what
# makes the Start menu's "Exit to shell" land in the RING-3 shell rather
# than the kernel's. It costs nothing while the desktop is up: a
# compositor holding the role MUTES the console's line discipline
# (keyboard.c's tty_set_bypass), so this blocks on fd 0 until the
# desktop exits and then has the keyboard. `rescue` starts no services
# at all, which is where the kernel shell gets the console back.
Name=tosh
Description=The console shell
Exec=/bin/tosh
Restart=always
# THE ONE SERVICE THAT MUST NOT LOG ITS STDOUT: this is an interactive
# shell and fd 1 is where its prompt and every command's output goes.
# Sent to the log instead, a `text` boot reaches a shell that answers
# nothing.
StandardOutput=inherit
# Ready at the first prompt: a shell that has printed nothing has not
# installed its signal handlers or its job table yet.
Ready=notify
