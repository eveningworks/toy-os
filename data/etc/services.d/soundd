# The system sound daemon: it owns the card and mixes every program
# into it, so two can be audible at once. Without it the FIRST program
# to ask gets the card and every later one is silent.
#
# Ready=notify: a client ordered after this waits for the beacon.
# See docs/commands/soundd.md.
#
# The whole file must fit in 512 bytes, comments included.
Name=soundd
Description=Mix every program's audio into the one sound stream
Exec=/bin/soundd
Restart=on-failure
Ready=notify
