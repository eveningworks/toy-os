# The desktop. Started by init when the boot target is `graphical`.
#
# See data/etc/services.d/README.md for the format, and
# docs/init-design.md for what init does with it.
Name=toywm
Description=The desktop
Exec=/bin/wm/system/toywm
Target=graphical
Restart=on-failure
# The desktop reports ready at its FIRST COMPOSITED FRAME, not when it
# claims the compositor role -- the framebuffer grant, the font, the
# cursor theme and the desktop entries all still happen in between, and
# a desktop that has claimed the role but drawn nothing is exactly the
# state `After=` could not tell from a working one. Nothing is ordered
# after it today; what this buys now is a log line saying when the
# desktop actually became usable, and a barrier that works the day
# something is.
Ready=notify
# AFTER THE FONT, so the first frame is drawn in it. Started beside
# fontd, the desktop drew in the kernel's baked fallback and switched a
# moment later -- 0.4 s on the ASUS, seconds on a busier boot, measured
# 2026-10-10. fontd reports ready once it has published (or found
# nothing to publish), init waits at most ReadyTimeout for it, and a
# fontd that is down holds nothing up: ordering, not a requirement.
After=fontd
# The compositor outranks every app, as KWin's SCHED_RR main thread does:
# a frame waits for nothing ordinary. It blocks between frames, which is
# what makes that safe -- see data/etc/services.d/README.md.
CPUSchedulingPolicy=rr
CPUSchedulingPriority=1
