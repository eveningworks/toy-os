# The scratch directory in RAM. A ONE-SHOT: it mounts and is done.
#
# %T is where `storage.tmpdir` says (/tmp by default), expanded by
# init -- a literal would stop agreeing with the setting.
# Size: `storage.ramfs_size`, 0 meaning half of free memory.
# What was on disk there is HIDDEN, not deleted.
Name=tmpfs
Description=Mount the scratch directory in RAM
Exec=/bin/mount
Args=-t ramfs none %T
Restart=no
