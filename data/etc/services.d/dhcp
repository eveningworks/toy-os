# An address for every card that has none, and it KEEPS it.
#
# `-k` stays resident: waits for carrier, retries a failed DISCOVER and
# renews at T1. A bare `dhcp` asks once and exits.
#
# Arguments go in Args=, not on Exec=.
# The whole file must fit in 512 bytes, comments included.
# See docs/commands/dhcp.md.
Name=dhcp
Description=Ask the network for an address, and keep it
Exec=/bin/dhcp
Args=-k
Restart=always
