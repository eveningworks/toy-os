# An address for every card that has none, and it KEEPS it.
#
# Waits for carrier before asking, then stays resident and renews at T1.
# `dhcp -1` is the old ask-and-exit behaviour.
#
# Restart=always: a service with a timer now, not a job that finishes.
#
# THE WHOLE FILE MUST FIT IN 512 BYTES, comments included -- that is
# etc_config.c's buffer. docs/commands/dhcp.md has the reasoning.
Name=dhcp
Description=Ask the network for an address, and keep it
Exec=/bin/dhcp
Restart=always
