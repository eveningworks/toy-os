# An address for every card that has none. Started by init on any
# target -- the network is not the desktop's.
#
# Restart=no makes this a ONE-SHOT: /bin/dhcp asks, applies what it is
# given and exits, and there is nothing to supervise afterwards. That is
# systemd's Type=oneshot, and init already reports it as `done` (or
# `failed`, which is how `service` answers "did this machine get an
# address?").
#
# NOT RESTARTED WHEN THE LEASE EXPIRES, because nothing here is watching
# the clock -- see docs/roadmap.md's renewal item. A machine up longer
# than its lease is using an address the server may have given away.
#
# There is no ordering key: nothing yet needs the network to be up
# before it starts, and After= would only say when this was SPAWNED.
#
# See data/etc/services.d/README.md for the format.
Name=dhcp
Description=Ask the network for an address
Exec=/bin/dhcp
Restart=no
