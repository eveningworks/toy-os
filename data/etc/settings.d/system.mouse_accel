Description=Move faster, and the pointer travels further still
# A SLIDER, because these are ordered levels: what a user means is
# "more" or "less", which a radio list cannot express and a dropdown
# hides behind a click.
Widget=slider
Choice.off=Off
Choice.low=Low
Choice.medium=Medium
Choice.high=High
# Appearance first, then behaviour -- which is NOT registration
# order, since cursor_config registers before mouse_config.
Order=40
