Type=enum
File=/etc/toyos.conf
Label=Cursor theme
Category=Input
Group=Mouse
Default=default
ChoiceDir=/usr/share/cursors
ChoiceDirMode=subdir
Description=Which set of pointer shapes to draw
# A gallery of cards, each drawing the theme's own shapes -- KDE's
# Cursors page. The list is every directory under /usr/share/cursors, so
# it grows with the themes.
Widget=gallery
Preview=cursor
Choice.default=Classic
Choice.bold=Classic bold
Choice.graphite=Graphite
Choice.accent=Accent
Choice.amber=Amber
Choice.aurora=Aurora
# Appearance first, then behaviour, within the Mouse group.
Order=10
