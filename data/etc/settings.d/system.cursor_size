Type=enum
File=/etc/toyos.conf
Label=Cursor size
Category=Input
Group=Mouse
Default=normal
Choices=normal,large,huge
Description=How large the mouse pointer is drawn
# The values are read by userland/wm/cursor_theme.c's adopt_settings()
# (1x, 2x, 3x) -- there is no "small", and a Choice line naming one
# would simply never match.
Choice.normal=Normal
Choice.large=Large
Choice.huge=Huge
